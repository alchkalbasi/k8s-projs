# ${BACKEND_URL} is substituted at container start (nginx image's envsubst entrypoint),
# so the same image works in docker-compose and Kubernetes without a rebuild.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Liveness/readiness for the frontend container itself. No upstream call.
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # Browser -> nginx -> backend. The browser never talks to the backend directly.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Hashed build assets never change: cache them for a year.
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # /tickets/new -> tickets/new.html. HTML is not cached so new rollouts show up right away.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri.html $uri/index.html =404;
    }

    error_page 404 /404.html;
}
