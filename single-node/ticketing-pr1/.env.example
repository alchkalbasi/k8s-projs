# Copy to .env and change before running anywhere non-local.
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me

# Package index used when building the backend image. Set a PyPI mirror if
# pypi.org is slow or blocked from your network, e.g.:
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
#   PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
# Nexus PyPI proxies need the /simple/ suffix:
#   PIP_INDEX_URL=https://repo.mizbaninternal.ir/repository/pypi/simple/
# PIP_INDEX_URL=https://pypi.org/simple

# Backend image version, stamped into the image and returned by GET /version.
# APP_VERSION=0.1.0
# GIT_COMMIT=abc123          # e.g. GIT_COMMIT=$(git rev-parse --short HEAD) docker compose build

# Backend runtime settings
# LOG_LEVEL=INFO
# STARTUP_DELAY_SECONDS=0    # /readyz returns 503 for N seconds after boot
